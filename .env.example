# Copy to .env and fill in your local values. Never commit .env.

# Required by the local AI agent for direct and AgntID runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local endpoints from docker-compose.yml.
SHOP_MCP_URL=http://localhost:9000/mcp
SHOP_ADMIN_BASE=http://localhost:9000
AGNTID_MCP_URL=http://localhost:8082/mcp

# Usually leave blank. Set only if your runtime MCP endpoint requires OAuth.
AGNTID_ACCESS_TOKEN=

# Set only if using a separately deployed AgntID runtime that needs a public
# callback endpoint. The portal's intent credential is configured separately.
# RUSE_AGENID_ENDPOINT=https://runtime.agntid.ai:8443
